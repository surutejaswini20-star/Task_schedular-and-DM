# Required in production: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
COOKIE_SECURE=false
TRUST_PROXY=false
PORT=5000

# Local development (SQLite). For Neon, use the PostgreSQL connection string
# from Neon and ensure it includes ?sslmode=require.
# SQLAlchemy/psycopg accepts postgresql+psycopg://... URLs.
DATABASE_URL=sqlite:///study_scheduler.db

# Celery broker. Local: redis://localhost:6379/0
# Hosted Redis with TLS commonly uses rediss://default:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379/0

# Brevo transactional email API. Verify the sender address in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=TaskScheduler and DeadlineManager
# Optional comma-separated disposable-email domains to block.
DISPOSABLE_EMAIL_DOMAINS=
